# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ถูก gitignore ไว้แล้ว
# ขอ key ได้ที่ https://aistudio.google.com/apikey

# ไม่ใส่ก็เล่นได้ทุกเกม แค่ฟีเจอร์ AI จะปิดตัวเองเงียบๆ
GEMINI_API_KEY=

# เพดานการเรียก Gemini รวมทั้งระบบต่อวัน กันโดนยิงจนโควตาหมด
GEMINI_DAILY_MAX=400

# สำรองไว้ตอน Google หมดโควตา — Google ตอบ 429 เมื่อไหร่ ระบบเด้งมาใช้ตัวนี้เอง
# ไม่ใส่ก็ได้ แค่หมดโควตาแล้วฟีเจอร์ AI จะหยุดจนถึงวันถัดไป
# ขอ key ได้ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=
